# =====================================================================
# 前端多阶段构建镜像：npm build → nginx 静态 + 反代
# 供远程仓库部署使用（目标机只需 Docker，无需本机 Node）
# 构建上下文 = 仓库根：docker build -f Dockerfile.web.remote -t per-web:latest .
# =====================================================================

# ---------- 阶段 1：Node 构建 ----------
FROM node:20-alpine AS build
WORKDIR /build
# 先拷依赖清单（命中缓存层），再拷源码构建
COPY per-web/package.json per-web/package-lock.json* ./
RUN (npm ci --no-audit --no-fund 2>/dev/null || npm install --no-audit --no-fund)
COPY per-web/ ./
RUN npm run build

# ---------- 阶段 2：Nginx 运行 ----------
FROM nginx:alpine
ENV TZ=Asia/Shanghai
# 反代配置：上游动态解析（server 容器重建换 IP 不致 502）
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html
EXPOSE 80
